### Visuals
font-family = FiraMono Nerd Font Mono
font-size = 18 
theme = Nvim Dark
cursor-style = bar

mouse-scroll-multiplier = 2
window-decoration = false
window-new-tab-position = end
confirm-close-surface = false

### keybindings
keybind = ctrl+r=reload_config

keybind = ctrl+t=new_tab
keybind = ctrl+w=close_surface

# scrolling behaviour - Might be changed, if vim mode is added
keybind = alt+up=scroll_page_lines:-1
keybind = alt+down=scroll_page_lines:1

keybind = page_up=scroll_page_up
keybind = page_down=scroll_page_down

# splits
keybind = ctrl+shift+v=new_split:right

keybind = ctrl+up=goto_split:top
keybind = ctrl+down=goto_split:bottom
keybind = ctrl+right=goto_split:right
keybind = ctrl+left=goto_split:left

# Search, for whenever that is added
keybind = ctrl+s=start_search

# automatically copy to clipboard, when marking text with mouse
copy-on-select = clipboard
keybind = ctrl+v=paste_from_clipboard

# Vim-mode keybindings

## Entry point
keybind = alt+escape=activate_key_table:vim

## Key table definition
keybind = vim/

## Line movement
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1

## Page movement
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up

## Jump to top/bottom
keybind = vim/g>g=scroll_to_top
keybind = vim/shift+g=scroll_to_bottom

## Search
keybind = vim/slash=start_search
keybind = vim/ctrl+s=start_search
keybind = vim/n=navigate_search:next

## Exit
keybind = vim/i=deactivate_key_table
keybind = vim/o=deactivate_key_table

keybind = vim/escape=text:\x1b
keybind = vim/q=text:\x1b

## Catch unbound keys
keybind = vim/catch_all=ignore
